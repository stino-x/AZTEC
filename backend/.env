
PRIVATE_KEY=""

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Database
DATABASE_URL="prisma+postgres://localhost:51213/?api__c3NsbW9kZT1kaXNhYmxlJmNvbm5lY3Rpb25fbGltaXQ9MSZjb25uZWN0X3RpbWVvdXQ9MCZtYXhfaWRsZV9jb25uZWN0aW9uX2xpZmV0aW1lPTAmcG9vbF90aW1lb3V0PTAmc2luZ2xlX3VzZV9jb25uZWN0aW9ucz10cnVlJnNvY2tldF90aW1lb3V0PTAifQ"

# JWT Configuration
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRATION_TIME="1d"
JWT_REFRESH_TOKEN_EXPIRATION="7d"

# Security
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# QR Code Configuration
AZTEC_ERROR_CORRECTION_LEVEL="23"  # 0-23 (higher = more robust)
KEY_EXPIRATION_DAYS="30"
QR_CODE_EXPIRATION_MINUTES="5"

# Email Configuration (SMTP)
MAIL_FROM="noreply@aztecschool.com"
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="your-email@example.com"
MAIL_PASSWORD="your-email-password"

# SMS Configuration (Twilio example)
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# File Uploads
MAX_FILE_SIZE=5242880  # 5MB
UPLOAD_PATH="./uploads"

# Logging
LOG_LEVEL="debug"
LOG_TO_FILE=true
LOG_FILE_PATH="./logs/app.log"

# CORS
CORS_ORIGIN="http://localhost:3001"
CORS_METHODS="GET,HEAD,PUT,PATCH,POST,DELETE"
CORS_CREDENTIALS=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_USERNAME="admin"
SWAGGER_PASSWORD="admin"